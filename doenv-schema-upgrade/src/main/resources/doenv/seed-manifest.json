{
  "manifestVersion": "2.0",
  "note": "PG 初始化数据规则：四张元数据表保持强一致重建；其余有初始化数据的表默认按 id 补缺并更新，四个审计字段不覆盖。",
  "defaultRule": {
    "category": "DATA",
    "strategy": "MERGE_FREEZE",
    "key": ["id"],
    "freeze": ["creatorid", "createdtime", "lastupdatorid", "lastupdatedtime"],
    "reason": "默认规则：按 id 补缺；已有 id 的非审计字段与纯净库不一致时更新；现场多出的 id 保留"
  },
  "tables": [
    {
      "table": "vao_entitytype",
      "category": "STRONG",
      "strategy": "REBUILD",
      "key": ["id"],
      "reason": "实体类型元数据强一致；关键数据有差异才重建；count 保存后回填",
      "rebuildCheckColumns": [
        "name", "ord", "tablename", "icon16", "icon32", "icon48", "icon64",
        "showedathome", "entitynocolumn", "entitylabelcolumn", "isdataentitytype"
      ],
      "preserve": ["count"]
    },
    {
      "table": "vao_entitytype_property",
      "category": "STRONG",
      "strategy": "REBUILD",
      "key": ["id"],
      "dependsOn": ["vao_entitytype"],
      "reason": "实体属性元数据随 vao_entitytype 强一致重建",
      "rebuildCheckColumns": [
        "name", "ord", "columnname", "datatype", "searchable", "listable",
        "archivable", "dictionaries", "concisearchivable", "expandable"
      ],
      "preserve": []
    },
    {
      "table": "vao_recordtype",
      "category": "STRONG",
      "strategy": "REBUILD",
      "key": ["id"],
      "reason": "记录类型元数据强一致；关键数据有差异才重建；count 保存后回填",
      "rebuildCheckColumns": [
        "name", "ord", "tablename", "icon16", "icon32", "icon48", "icon64",
        "showedathome", "recordidcolumn", "categoryid", "isbackduplicate",
        "datetimecolumn", "datecolumn", "timecolumn", "showclass", "showmethod", "usage"
      ],
      "preserve": ["count"]
    },
    {
      "table": "vao_recordtype_column",
      "category": "STRONG",
      "strategy": "REBUILD",
      "key": ["id"],
      "dependsOn": ["vao_recordtype"],
      "reason": "记录字段元数据随 vao_recordtype 强一致重建",
      "rebuildCheckColumns": [
        "name", "ord", "columnname", "datatype", "searchable", "listable",
        "archivable", "duplicatable", "insertable", "dictionaries", "expandable"
      ],
      "preserve": []
    },
    {
      "table": "vao_case_table_field_conf",
      "category": "DATA",
      "strategy": "MERGE_FREEZE",
      "key": ["entitytypeid"],
      "freeze": ["creatorid", "createdtime", "lastupdatorid", "lastupdatedtime"],
      "reason": "按 entitytypeid 补缺和更新，四个审计字段保留现场值"
    },
    {
      "table": "vao_entity_chart_conf",
      "category": "DATA",
      "strategy": "MERGE_FREEZE",
      "key": ["entitytypeid"],
      "freeze": ["creatorid", "createdtime", "lastupdatorid", "lastupdatedtime"],
      "reason": "按 entitytypeid 补缺和更新；当前基准无初始化行，未来加入后自动生效"
    },
    {
      "table": "vao_system_opt",
      "category": "DATA",
      "strategy": "INSERT_ONLY",
      "key": ["key"],
      "reason": "该表没有 id，按实际唯一标识 key 只补缺行，已有配置不更新"
    },
    {
      "table": "vao_user",
      "category": "DATA",
      "strategy": "INSERT_ONLY",
      "key": ["id"],
      "reason": "按 id 只补缺失用户，不更新现场账号"
    },
    {
      "table": "vao_usergroup",
      "category": "DATA",
      "strategy": "INSERT_ONLY",
      "key": ["id"],
      "reason": "按 id 只补缺失用户组，不更新现场组织"
    }
  ]
}
